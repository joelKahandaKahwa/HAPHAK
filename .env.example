# ============================================================
# HAPHAK — variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# Aucune valeur secrète réelle ne doit figurer ici.
# ============================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL — fournie par Render (Internal Database URL)
DATABASE_URL=

# Secret de session : openssl rand -hex 32
SESSION_SECRET=

# Compte administrateur créé au premier démarrage.
# Le mot de passe est hashé avec bcrypt, jamais stocké en clair.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP (envoi des e-mails de confirmation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
